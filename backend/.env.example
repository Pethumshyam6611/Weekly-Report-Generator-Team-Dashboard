NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=weekly_reports
DB_USER=root
DB_PASSWORD=change_me
DB_LOGGING=false

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_DAYS=7

BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000

MANAGER_INVITE_CODE=replace_with_a_private_manager_invite_code
REPORT_GRACE_DAYS=1

GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
